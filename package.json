    "@tauri-apps/plugin-opener": "^2.7.2",
    "clsx": "^2.1.1",
    "i18next": "^26.5.12",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.1",
